+/*
+** nx2_lang.h
+** UZDoom NX2: language of the port's own screens (loading screen, fatal
+** errors), the same as the launcher's: English (default), French, Portuguese.
+**
+** Copyright 2026 UZDoom NX2 contributors. GPLv3 (same as UZDoom).
+*/
+#pragma once
+
+enum NX2Lang { NX2_LANG_EN = 0, NX2_LANG_FR = 1, NX2_LANG_PT = 2 };
+
+// Set from the launcher's "-nxlang <en|fr|pt>" switch.
+void NX2_SetLangCode(const char *code);
+// The language; without -nxlang it is read (read only) from the launcher's
+// config/launcher.json, and English if that has none.
+NX2Lang NX2_Lang();
+// Picks the string for the current language.
+const char *NX2_Tr(const char *en, const char *fr, const char *pt);
