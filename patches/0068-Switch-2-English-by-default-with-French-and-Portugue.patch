--- /dev/null
+++ b/src/common/platform/posix/nx/nx2_lang.cpp
@@ -0,0 +1,59 @@
+/*
+** nx2_lang.cpp
+** UZDoom NX2: language of the port's own screens. See nx2_lang.h.
+**
+** Copyright 2026 UZDoom NX2 contributors. GPLv3 (same as UZDoom).
+*/
+
+#include "nx2_lang.h"
+#include "nx2_pathpolicy.h"
+
+#include <stdio.h>
+#include <string.h>
+
+static int g_lang = -1;
+
+void NX2_SetLangCode(const char *code)
+{
+	if (!code) return;
+	if (!strcmp(code, "fr")) g_lang = NX2_LANG_FR;
+	else if (!strcmp(code, "pt")) g_lang = NX2_LANG_PT;
+	else g_lang = NX2_LANG_EN;
+}
+
+NX2Lang NX2_Lang()
+{
+	if (g_lang < 0)
+	{
+		g_lang = NX2_LANG_EN;
+		// "language": "fr" in the launcher's settings (opened read only)
+		FILE *f = fopen(NX2_SANDBOX_ROOT "/config/launcher.json", "rb");
+		if (f)
+		{
+			char buf[4096];
+			size_t n = fread(buf, 1, sizeof(buf) - 1, f);
+			fclose(f);
+			buf[n] = 0;
+			const char *k = strstr(buf, "\"language\"");
+			const char *q = k ? strchr(k + 10, '"') : nullptr;
+			if (q)
+			{
+				char code[8] = {};
+				for (int i = 0; i < 7 && q[1 + i] && q[1 + i] != '"'; i++)
+					code[i] = q[1 + i];
+				NX2_SetLangCode(code);
+			}
+		}
+	}
+	return (NX2Lang)g_lang;
+}
+
+const char *NX2_Tr(const char *en, const char *fr, const char *pt)
+{
+	switch (NX2_Lang())
+	{
+	case NX2_LANG_FR: return fr;
+	case NX2_LANG_PT: return pt;
+	default: return en;
+	}
+}
