-CVAR(Bool, nx_gyro, true, CVAR_ARCHIVE | CVAR_GLOBALCONFIG)
-CVAR(Float, nx_gyro_sensitivity, 2.5f, CVAR_ARCHIVE | CVAR_GLOBALCONFIG)
+CVAR(Bool, nx_gyro, false, CVAR_ARCHIVE | CVAR_GLOBALCONFIG)
+// first test (2026-11-19): 2.5 on both axes was too slow horizontally and
+// too fast vertically
+CVAR(Float, nx_gyro_sensitivity, 3.5f, CVAR_ARCHIVE | CVAR_GLOBALCONFIG)
+CVAR(Float, nx_gyro_sensitivity_y, 1.5f, CVAR_ARCHIVE | CVAR_GLOBALCONFIG)
 CVAR(Bool, nx_gyro_invert_x, false, CVAR_ARCHIVE | CVAR_GLOBALCONFIG)
 CVAR(Bool, nx_gyro_invert_y, false, CVAR_ARCHIVE | CVAR_GLOBALCONFIG)
 // angular speed (turns per second) below which the gyro is ignored: hides the
@@ -196,24 +202,33 @@ void NX2_MotionFrame()
 	const size_t n = hidGetSixAxisSensorStates(d.six[d.sensor], states, 17);
 	if (n == 0)
 		return;
-	// the newest samples first: average the angular velocity of the ones not
-	// seen yet, follow gravity with the newest acceleration
+	// The newest samples come first. The rotation is integrated sample by
+	// sample over the time each one covers (its delta_time), not as an
+	// average spread over the frame: the view then follows the hand at the
+	// sensor's own rate, without the jerks of frames that saw more or fewer
+	// samples. w holds the rotation (in turns) since the previous frame.
 	float w[3] = { 0, 0, 0 };
 	int fresh = 0;
-	for (size_t i = 0; i < n; i++)
+	double covered = 0;
+	const bool firstRead = lastSample == 0;
+	for (size_t i = 0; i < n && !firstRead; i++)
 	{
 		if (states[i].sampling_number <= lastSample)
 			break;
-		w[0] += states[i].angular_velocity.x;
-		w[1] += states[i].angular_velocity.y;
-		w[2] += states[i].angular_velocity.z;
+		// delta_time is in nanoseconds; ignore implausible values (and use
+		// the sensor's 200 Hz period instead)
+		double sdt = states[i].delta_time / 1e9;
+		if (!(sdt > 0.0005 && sdt < 0.05))
+			sdt = 0.005;
+		w[0] += states[i].angular_velocity.x * (float)sdt;
+		w[1] += states[i].angular_velocity.y * (float)sdt;
+		w[2] += states[i].angular_velocity.z * (float)sdt;
+		covered += sdt;
 		fresh++;
 	}
 	lastSample = states[0].sampling_number;
 	if (fresh == 0)
 		return;
-	for (float &c : w)
-		c /= fresh;
 
 	const float a[3] = { states[0].acceleration.x, states[0].acceleration.y, states[0].acceleration.z };
 	if (!gravityValid)
@@ -239,8 +254,10 @@ void NX2_MotionFrame()
 	if (glen < 0.3f)
 		return;	// free fall or a bad sample
 	const float up[3] = { -gravity[0] / glen, -gravity[1] / glen, -gravity[2] / glen };
-	float yawLeft = w[0] * up[0] + w[1] * up[1] + w[2] * up[2];	// turns per second
-	float pitchUp = w[0];											// about the controller's left-right axis
+	// turns over the samples read; the dead zone works on the speed
+	const float spd = covered > 0 ? (float)(1.0 / covered) : 0.f;
+	float yawLeft = (w[0] * up[0] + w[1] * up[1] + w[2] * up[2]) * spd;	// turns per second
+	float pitchUp = w[0] * spd;												// about the controller's left-right axis
 
 	const float dz = nx_gyro_deadzone;
 	auto soften = [dz](float v) {
@@ -256,9 +273,8 @@ void NX2_MotionFrame()
 	if (nx_gyro_invert_y) pitchUp = -pitchUp;
 
 	// G_AddViewAngle/Pitch take 1/65536 of a turn; a positive yaw turns right
-	const double scale = 65536.0 * nx_gyro_sensitivity * dt;
-	yawRest += -yawLeft * scale;
-	pitchRest += pitchUp * scale;
+	yawRest += -yawLeft * covered * 65536.0 * nx_gyro_sensitivity;
+	pitchRest += pitchUp * covered * 65536.0 * nx_gyro_sensitivity_y;
 	const int yaw = (int)yawRest, pitch = (int)pitchRest;
 	yawRest -= yaw;
 	pitchRest -= pitch;
