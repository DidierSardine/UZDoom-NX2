+// "/" and "/switch", the folders that contain the sandbox: creating them
+// would write nothing new, and they exist (the .nro is in one of them).
+static int NX2_IsSandboxAncestor(const char *canon)
+{
+	return !strcmp(canon, "/") || !strcasecmp(canon, "/switch");
+}
+
 static int G_mkdir(struct _reent *r, const char *path, int mode)
 {
+	char cwd[NX2_PATH_MAX + 2];
+	char canon[NX2_PATH_MAX + 1];
+	NX2_GetCwd(cwd, sizeof(cwd));
+	if (NX2_PathCheck(cwd[0] ? cwd : NULL, path, NX2_OP_MAKE_DIR, canon) == NX2_PATH_OUTSIDE &&
+		NX2_IsSandboxAncestor(canon))
+	{
+		// "mkdir -p" of a path inside the sandbox (OunceVK's shader cache
+		// does this): answer as the file system would, without writing
+		struct stat st;
+		if (g_original->stat_r && g_original->stat_r(r, canon, &st) == 0)
+		{
+			r->_errno = EEXIST;
+			return -1;
+		}
+	}
 	if (NX2_Allow(r, "mkdir", path, NX2_OP_MAKE_DIR))
 		return -1;
 	return g_original->mkdir_r(r, path, mode);
diff --git a/src/common/platform/posix/nx/nx2_motion.cpp b/src/common/platform/posix/nx/nx2_motion.cpp
new file mode 100644
index 0000000000..5b9e3603f2
--- /dev/null
+++ b/src/common/platform/posix/nx/nx2_motion.cpp
@@ -0,0 +1,279 @@
+/*
+** nx2_motion.cpp
+** UZDoom NX2: controller rumble and gyro aiming on the Switch 2.
+**
+** Rumble: devkitPro's SDL2 never initializes the vibration device of its
+** first joystick (handheld / player 1), passes a style *set* where HID wants
+** one style, and sends an amplitude of 320 where HID expects 0..1, so
+** UZDoom's haptics did nothing. I_Rumble comes here instead and drives the
+** HID vibration devices of the active controller directly.
+**
+** Gyro: SDL2's Switch port has no motion sensors. The six-axis sensors of the
+** active controller are read every frame and turned into view rotation in
+** "player space": the yaw axis follows gravity, so turning works the same
+** with the console held upright, flat, with a single Joy-Con or a Pro
+** Controller. Pitch follows the controller's own left-right axis.
+**
+**   nx_gyro 1                 gyro aiming on (default) / 0 off
+**   nx_gyro_sensitivity 2.5   1 = the view turns as much as the controller
+**   nx_gyro_invert_x/_y       flip one axis
+**   gyro_reset                level the view and restart the gravity estimate
+**                             (bound to the left stick click when it is free)
+**
+** Copyright 2026 UZDoom NX2 contributors. GPLv3 (same as UZDoom).
+*/
+
+#ifdef __SWITCH2__
+
+#include <switch.h>
+#include <math.h>
+#include <string.h>
+
+#include "c_cvars.h"
+#include "c_dispatch.h"
+#include "c_console.h"
+#include "c_bind.h"
+#include "d_event.h"
+#include "doomstat.h"
+#include "menu.h"
+#include "keydef.h"
+#include "i_interface.h"
+
+void G_AddViewAngle(int yaw, bool mouse);
+void G_AddViewPitch(int look, bool mouse);
+
+CVAR(Bool, nx_gyro, true, CVAR_ARCHIVE | CVAR_GLOBALCONFIG)
+CVAR(Float, nx_gyro_sensitivity, 2.5f, CVAR_ARCHIVE | CVAR_GLOBALCONFIG)
+CVAR(Bool, nx_gyro_invert_x, false, CVAR_ARCHIVE | CVAR_GLOBALCONFIG)
+CVAR(Bool, nx_gyro_invert_y, false, CVAR_ARCHIVE | CVAR_GLOBALCONFIG)
+// angular speed (turns per second) below which the gyro is ignored: hides the
+// sensor noise of a controller held still (0.004 = 1.4 degrees per second)
+CVAR(Float, nx_gyro_deadzone, 0.004f, CVAR_ARCHIVE | CVAR_GLOBALCONFIG)
+
+namespace
+{
+	enum Slot { SlotHandheld, SlotFullKey, SlotJoyDual, SlotJoyLeft, SlotJoyRight, SlotCount };
+
+	struct Device
+	{
+		HidNpadIdType id;
+		HidNpadStyleTag style;
+		int count;					// vibration devices / six-axis handles
+		int sensor;					// which six-axis handle aims (the right Joy-Con of a pair)
+		HidVibrationDeviceHandle vib[2];
+		HidSixAxisSensorHandle six[2];
+		bool vibOk, sixOk;
+	};
+
+	Device devices[SlotCount] = {
+		{ HidNpadIdType_Handheld, HidNpadStyleTag_NpadHandheld, 2, 0 },
+		{ HidNpadIdType_No1, HidNpadStyleTag_NpadFullKey, 2, 0 },
+		{ HidNpadIdType_No1, HidNpadStyleTag_NpadJoyDual, 2, 1 },
+		{ HidNpadIdType_No1, HidNpadStyleTag_NpadJoyLeft, 1, 0 },
+		{ HidNpadIdType_No1, HidNpadStyleTag_NpadJoyRight, 1, 0 },
+	};
+
+	bool initialized = false;
+	uint64_t lastTick = 0;
+	uint64_t lastSample = 0;
+	int lastSlot = -1;
+	float gravity[3] = { 0, 0, 0 };
+	bool gravityValid = false;
+	double yawRest = 0, pitchRest = 0;	// sub-unit remainders
+	float rumbleLow = 0, rumbleHigh = 0;
+
+	void Init()
+	{
+		if (initialized)
+			return;
+		initialized = true;
+		for (auto &d : devices)
+		{
+			// six-axis handles: one for handheld, Pro Controller and single
+			// Joy-Con, two (left, right) for a Joy-Con pair
+			const int sixCount = d.style == HidNpadStyleTag_NpadJoyDual ? 2 : 1;
+			d.sixOk = R_SUCCEEDED(hidGetSixAxisSensorHandles(d.six, sixCount, d.id, d.style));
+			if (d.sixOk)
+				for (int i = 0; i < sixCount; i++)
+					hidStartSixAxisSensor(d.six[i]);
+			d.vibOk = R_SUCCEEDED(hidInitializeVibrationDevices(d.vib, d.count, d.id, d.style));
+		}
+	}
+
+	// the controller the player is using: the handheld Joy-Con when attached,
+	// else player 1's controller in the style it is connected as
+	int ActiveSlot()
+	{
+		if (hidGetNpadStyleSet(HidNpadIdType_Handheld) & HidNpadStyleTag_NpadHandheld)
+			return SlotHandheld;
+		const u32 st = hidGetNpadStyleSet(HidNpadIdType_No1);
+		if (st & HidNpadStyleTag_NpadFullKey) return SlotFullKey;
+		if (st & HidNpadStyleTag_NpadJoyDual) return SlotJoyDual;
+		if (st & HidNpadStyleTag_NpadJoyRight) return SlotJoyRight;
+		if (st & HidNpadStyleTag_NpadJoyLeft) return SlotJoyLeft;
+		return -1;
+	}
+
+	void SendRumble(int slot, float low, float high)
+	{
+		if (slot < 0 || !devices[slot].vibOk)
+			return;
+		Device &d = devices[slot];
+		HidVibrationValue v[2];
+		for (int i = 0; i < d.count; i++)
+		{
+			v[i].amp_low = low;
+			v[i].freq_low = 160.0f;
+			v[i].amp_high = high;
+			v[i].freq_high = 320.0f;
+		}
+		hidSendVibrationValues(d.vib, v, d.count);
+	}
+
+	bool GyroWanted()
+	{
+		return nx_gyro && gamestate == GS_LEVEL && menuactive == MENU_Off && ConsoleState == c_up && !paused;
+	}
+}
+
+// UZDoom's haptics (I_Rumble): 0..1 for the low and high frequency motors.
+void NX2_Rumble(float high, float low)
+{
+	Init();
+	if (high < 0) high = 0; else if (high > 1) high = 1;
+	if (low < 0) low = 0; else if (low > 1) low = 1;
+	rumbleLow = low;
+	rumbleHigh = high;
+	SendRumble(ActiveSlot(), low, high);
+}
+
+void NX2_RumbleStop()
+{
+	if (!initialized)
+		return;
+	for (int s = 0; s < SlotCount; s++)
+		SendRumble(s, 0, 0);
+	rumbleLow = rumbleHigh = 0;
+}
+
+static void ResetGyro()
+{
+	gravityValid = false;
+	yawRest = pitchRest = 0;
+}
+
+CCMD(gyro_reset)
+{
+	ResetGyro();
+	C_DoCommand("centerview");
+}
+
+// Once per frame, on the game thread (I_StartFrame).
+void NX2_MotionFrame()
+{
+	Init();
+	const uint64_t now = armGetSystemTick();
+	const double dt = lastTick ? armTicksToNs(now - lastTick) / 1e9 : 0.0;
+	lastTick = now;
+
+	const int slot = ActiveSlot();
+	if (slot != lastSlot)
+	{
+		// a new controller: carry the rumble over, start the gravity estimate again
+		if (lastSlot >= 0 && (rumbleLow > 0 || rumbleHigh > 0))
+			SendRumble(lastSlot, 0, 0);
+		if (slot >= 0 && (rumbleLow > 0 || rumbleHigh > 0))
+			SendRumble(slot, rumbleLow, rumbleHigh);
+		lastSlot = slot;
+		lastSample = 0;
+		ResetGyro();
+	}
+	if (slot < 0 || !devices[slot].sixOk || dt <= 0 || dt > 0.25)
+		return;
+
+	Device &d = devices[slot];
+	HidSixAxisSensorState states[17];
+	const size_t n = hidGetSixAxisSensorStates(d.six[d.sensor], states, 17);
+	if (n == 0)
+		return;
+	// the newest samples first: average the angular velocity of the ones not
+	// seen yet, follow gravity with the newest acceleration
+	float w[3] = { 0, 0, 0 };
+	int fresh = 0;
+	for (size_t i = 0; i < n; i++)
+	{
+		if (states[i].sampling_number <= lastSample)
+			break;
+		w[0] += states[i].angular_velocity.x;
+		w[1] += states[i].angular_velocity.y;
+		w[2] += states[i].angular_velocity.z;
+		fresh++;
+	}
+	lastSample = states[0].sampling_number;
+	if (fresh == 0)
+		return;
+	for (float &c : w)
+		c /= fresh;
+
+	const float a[3] = { states[0].acceleration.x, states[0].acceleration.y, states[0].acceleration.z };
+	if (!gravityValid)
+	{
+		memcpy(gravity, a, sizeof(gravity));
+		gravityValid = true;
+	}
+	else
+	{
+		const float k = (float)fmin(1.0, dt * 2.0);	// ~0.5 s low-pass
+		for (int i = 0; i < 3; i++)
+			gravity[i] += (a[i] - gravity[i]) * k;
+	}
+	if (!GyroWanted())
+	{
+		yawRest = pitchRest = 0;
+		return;
+	}
+
+	// HID reports acceleration toward the ground (0, 0, -1 lying flat):
+	// "up" is the opposite. Turning left is a positive rotation about it.
+	const float glen = sqrtf(gravity[0] * gravity[0] + gravity[1] * gravity[1] + gravity[2] * gravity[2]);
+	if (glen < 0.3f)
+		return;	// free fall or a bad sample
+	const float up[3] = { -gravity[0] / glen, -gravity[1] / glen, -gravity[2] / glen };
+	float yawLeft = w[0] * up[0] + w[1] * up[1] + w[2] * up[2];	// turns per second
+	float pitchUp = w[0];											// about the controller's left-right axis
+
+	const float dz = nx_gyro_deadzone;
+	auto soften = [dz](float v) {
+		// below the dead zone the movement fades in instead of jumping
+		const float m = fabsf(v);
+		if (m >= 2 * dz) return v;
+		if (m <= dz * 0.5f) return 0.0f;
+		return v * (m - dz * 0.5f) / (1.5f * dz);
+	};
+	yawLeft = soften(yawLeft);
+	pitchUp = soften(pitchUp);
+	if (nx_gyro_invert_x) yawLeft = -yawLeft;
+	if (nx_gyro_invert_y) pitchUp = -pitchUp;
+
+	// G_AddViewAngle/Pitch take 1/65536 of a turn; a positive yaw turns right
+	const double scale = 65536.0 * nx_gyro_sensitivity * dt;
+	yawRest += -yawLeft * scale;
+	pitchRest += pitchUp * scale;
+	const int yaw = (int)yawRest, pitch = (int)pitchRest;
+	yawRest -= yaw;
+	pitchRest -= pitch;
+	if (yaw)
+		G_AddViewAngle(yaw, true);
+	if (pitch)
+		G_AddViewPitch(pitch, true);
+}
+
+// After the configuration is loaded: the left stick click resets the gyro
+// unless the player bound it to something else.
+void NX2_MotionDefaultBindings()
+{
+	if (Bindings.GetBinding(KEY_PAD_LTHUMB).IsEmpty())
+		Bindings.SetBind(KEY_PAD_LTHUMB, "gyro_reset");
+}
+
+#endif // __SWITCH2__
