+
+// Switch 2: a GPU that stops (a hang, not a reported loss) used to freeze the
+// game for good on an infinite fence wait, with the music still playing.
+// Waits are bounded: after 20 s the device counts as lost and the game stops
+// with an error (and the logs say where), instead of hanging silently.
+static void NX2_WaitFences(VkDevice device, uint32_t count, const VkFence *fences, const char *where)
+{
+#ifdef __SWITCH2__
+	if (VulkanDeviceWasLost || count == 0)
+		return;
+	for (int i = 0; i < 4; i++)
+	{
+		const VkResult r = vkWaitForFences(device, count, fences, VK_TRUE, 5'000'000'000ull);
+		if (r == VK_SUCCESS)
+			return;
+		if (r != VK_TIMEOUT)
+		{
+			VulkanDeviceWasLost = true;
+			if (VulkanDeviceLostCallback)
+				VulkanDeviceLostCallback(where);
+			VulkanError("The GPU stopped (device lost while waiting for a frame)");
+		}
+	}
+	VulkanDeviceWasLost = true;
