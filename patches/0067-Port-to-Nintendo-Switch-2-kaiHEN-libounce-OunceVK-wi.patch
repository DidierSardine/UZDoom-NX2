@@ -0,0 +1,332 @@
+/*
+** nx2_fsguard.c
+** UZDoom NX2: SD card write firewall.
+**
+** kaiHEN gives homebrew an unrestricted FS session: a program could open the
+** system NAND and damage it. UZDoom NX2 protects the console in three layers:
+**
+**   1. It never opens anything but the SD card. The final ELF is checked for
+**      every libnx entry point that reaches NAND, save data, system settings
+**      or another storage (tests/check_nand_safety.sh): the build fails if one
+**      is linked.
+**   2. Every file system call of the C library - from the engine, the
+**      launcher, ZMusic, SDL, the Vulkan driver, any library - goes through
+**      newlib's device table. This file replaces the "sdmc" entry of that
+**      table with a copy whose write operations first ask nx2_pathpolicy.c:
+**      only paths inside sdmc:/switch/uzdoom-nx2 may be created, written,
+**      truncated, removed, renamed or have their attributes changed. Reads
+**      are not restricted (IWADs and mods may be anywhere on the card).
+**   3. All other file system devices are unmounted, so there is no other
+**      device a path could name.
+**
+** A refused call fails with EACCES and is recorded for the log; the program
+** carries on.
+**
+** Copyright 2026 UZDoom NX2 contributors. GPLv3 (same as UZDoom).
+*/
+
+#ifdef __SWITCH__
+
+#include "nx2_fsguard.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/iosupport.h>
+#include <switch.h>
+
+static devoptab_t g_guarded;              // our copy of the sdmc entry
+static const devoptab_t *g_original;      // fsdev's own entry (its functions do the work)
+static int g_index = -1;                  // its slot in devoptab_list
+static int g_active = 0;
+static unsigned g_reinstalls = 0;
+static char g_report[512];
+
+// Working directory of the sdmc device as fsdev resolves it ("/a/b/").
+static Mutex g_cwdMutex;
+static char g_cwd[NX2_PATH_MAX + 2] = "";
+
+// Refused writes, for the log.
+#define NX2_DENIAL_KEEP 16
+static Mutex g_denyMutex;
+static unsigned g_denials = 0;
+static char g_denied[NX2_DENIAL_KEEP][160];
+
+static void NX2_GetCwd(char *out, size_t size)
+{
+	mutexLock(&g_cwdMutex);
+	strncpy(out, g_cwd, size - 1);
+	out[size - 1] = 0;
+	mutexUnlock(&g_cwdMutex);
+}
+
+static void NX2_RecordDenial(const char *op, const char *path, NX2PathVerdict v)
+{
+	mutexLock(&g_denyMutex);
+	char *slot = g_denied[g_denials % NX2_DENIAL_KEEP];
+	snprintf(slot, sizeof(g_denied[0]), "%s '%.100s': %s", op, path ? path : "(null)", NX2_PathVerdictName(v));
+	g_denials++;
+	mutexUnlock(&g_denyMutex);
+}
+
+// 0 when 'path' may be changed by 'op'; otherwise sets errno and returns -1.
+static int NX2_Allow(struct _reent *r, const char *opName, const char *path, NX2PathOp op)
+{
+	char cwd[NX2_PATH_MAX + 2];
+	NX2_GetCwd(cwd, sizeof(cwd));
+	NX2PathVerdict v = NX2_PathCheck(cwd[0] ? cwd : NULL, path, op, NULL);
+	if (v == NX2_PATH_OK)
+		return 0;
+	NX2_RecordDenial(opName, path, v);
+	r->_errno = EACCES;
+	return -1;
+}
+
+// ---------------------------------------------------------------------------
+// guarded operations
+// ---------------------------------------------------------------------------
+
+static int G_open(struct _reent *r, void *fileStruct, const char *path, int flags, int mode)
+{
+	const int writes = (flags & O_ACCMODE) != O_RDONLY || (flags & (O_CREAT | O_TRUNC | O_APPEND));
+	if (writes && NX2_Allow(r, "open-write", path, NX2_OP_WRITE_FILE))
+		return -1;
+	return g_original->open_r(r, fileStruct, path, flags, mode);
+}
+
+static int G_link(struct _reent *r, const char *existing, const char *newLink)
+{
+	if (NX2_Allow(r, "link", existing, NX2_OP_WRITE_FILE) || NX2_Allow(r, "link", newLink, NX2_OP_WRITE_FILE))
+		return -1;
+	if (!g_original->link_r) { r->_errno = ENOSYS; return -1; }
+	return g_original->link_r(r, existing, newLink);
+}
+
+static int G_unlink(struct _reent *r, const char *name)
+{
+	if (NX2_Allow(r, "unlink", name, NX2_OP_WRITE_FILE))
+		return -1;
+	return g_original->unlink_r(r, name);
+}
+
+static int G_chdir(struct _reent *r, const char *name)
+{
+	char canon[NX2_PATH_MAX + 1];
+	char cwd[NX2_PATH_MAX + 2];
+	NX2_GetCwd(cwd, sizeof(cwd));
+	// only inside the sandbox: relative paths then always start there
+	NX2PathVerdict v = NX2_PathCheck(cwd[0] ? cwd : NULL, name, NX2_OP_CHDIR, canon);
+	if (v != NX2_PATH_OK)
+	{
+		NX2_RecordDenial("chdir", name, v);
+		r->_errno = EACCES;
+		return -1;
+	}
+	mutexLock(&g_cwdMutex);
+	int ret = g_original->chdir_r(r, canon);
+	if (ret == 0)
+	{
+		size_t n = strlen(canon);
+		memcpy(g_cwd, canon, n + 1);
+		if (n == 0 || g_cwd[n - 1] != '/')
+		{
+			g_cwd[n] = '/';
+			g_cwd[n + 1] = 0;
+		}
+	}
+	mutexUnlock(&g_cwdMutex);
+	return ret;
+}
+
+static int G_rename(struct _reent *r, const char *oldName, const char *newName)
+{
+	if (NX2_Allow(r, "rename-from", oldName, NX2_OP_WRITE_FILE) || NX2_Allow(r, "rename-to", newName, NX2_OP_WRITE_FILE))
+		return -1;
+	return g_original->rename_r(r, oldName, newName);
+}
+
+static int G_mkdir(struct _reent *r, const char *path, int mode)
+{
+	if (NX2_Allow(r, "mkdir", path, NX2_OP_MAKE_DIR))
+		return -1;
+	return g_original->mkdir_r(r, path, mode);
+}
+
+static int G_rmdir(struct _reent *r, const char *name)
+{
+	if (NX2_Allow(r, "rmdir", name, NX2_OP_REMOVE_DIR))
+		return -1;
+	return g_original->rmdir_r(r, name);
+}
+
+static int G_chmod(struct _reent *r, const char *path, mode_t mode)
+{
+	if (NX2_Allow(r, "chmod", path, NX2_OP_WRITE_FILE))
+		return -1;
+	if (!g_original->chmod_r) { r->_errno = ENOSYS; return -1; }
+	return g_original->chmod_r(r, path, mode);
+}
+
+static int G_utimes(struct _reent *r, const char *path, const struct timeval times[2])
+{
+	if (NX2_Allow(r, "utimes", path, NX2_OP_WRITE_FILE))
+		return -1;
+	if (!g_original->utimes_r) { r->_errno = ENOSYS; return -1; }
+	return g_original->utimes_r(r, path, times);
+}
+
+static int G_symlink(struct _reent *r, const char *target, const char *linkpath)
+{
+	if (NX2_Allow(r, "symlink", linkpath, NX2_OP_WRITE_FILE))
+		return -1;
+	if (!g_original->symlink_r) { r->_errno = ENOSYS; return -1; }
+	return g_original->symlink_r(r, target, linkpath);
+}
+
+// ---------------------------------------------------------------------------
+// installation
+// ---------------------------------------------------------------------------
+
+static void NX2_Report(const char *fmt, const char *arg)
+{
+	size_t n = strlen(g_report);
+	if (n < sizeof(g_report) - 1)
+		snprintf(g_report + n, sizeof(g_report) - n, fmt, arg);
+}
+
+// Devices that are not file systems (C streams, console, sockets) and the
+// two file systems the program may use. Anything else is unmounted.
+static int NX2_IsExpectedDevice(const char *name)
+{
+	static const char *const ok[] = { "stdnull", "stdin", "stdout", "stderr", "con", "soc", "sdmc", "romfs" };
+	for (size_t i = 0; i < sizeof(ok) / sizeof(ok[0]); i++)
+		if (!strcmp(name, ok[i]))
+			return 1;
+	return 0;
+}
+
+static int NX2_Apply(void)
+{
+	int idx = AddDevice(&g_guarded);	// replaces the entry of the same name, in place
+	if (idx < 0 || devoptab_list[idx] != &g_guarded)
+		return -1;
+	g_index = idx;
+	setDefaultDevice(idx);
+	return 0;
+}
+
+__attribute__((noinline, used)) int NX2_FsGuardInstall(void)
+{
+	mutexInit(&g_cwdMutex);
+	mutexInit(&g_denyMutex);
+	g_report[0] = 0;
+
+	const int sdIdx = FindDevice("sdmc:");
+	if (sdIdx < 0)
+	{
+		NX2_Report("%s", "no SD card device; ");
+		return -1;
+	}
+	g_original = devoptab_list[sdIdx];
+	if (!g_original || !g_original->open_r || !g_original->chdir_r || !g_original->mkdir_r)
+	{
+		NX2_Report("%s", "SD card device incomplete; ");
+		return -1;
+	}
+
+	g_guarded = *g_original;	// same name, same deviceData: fsdev still does the work
+	g_guarded.open_r = G_open;
+	g_guarded.link_r = G_link;
+	g_guarded.unlink_r = G_unlink;
+	g_guarded.chdir_r = G_chdir;
+	g_guarded.rename_r = G_rename;
+	g_guarded.mkdir_r = G_mkdir;
+	g_guarded.rmdir_r = G_rmdir;
+	g_guarded.chmod_r = G_chmod;
+	g_guarded.utimes_r = G_utimes;
+	g_guarded.symlink_r = G_symlink;
+	// fd-based calls (write, ftruncate, fchmod, fsync) can only reach files
+	// that G_open opened for writing; fsdev refuses writes to read-only fds.
+
+	// Create and enter the sandbox through fsdev directly, before the
+	// firewall knows the working directory. /switch itself is never created:
+	// the .nro lives in it.
+	struct _reent *r = _REENT;
+	void *saved = r->deviceData;
+	r->deviceData = g_original->deviceData;
+	int mk = g_original->mkdir_r(r, NX2_SANDBOX_ROOT, 0777);
+	int mkErr = r->_errno;
+	int cd = g_original->chdir_r(r, NX2_SANDBOX_ROOT);
+	r->deviceData = saved;
+	if (cd != 0)
+	{
+		NX2_Report("%s", mk != 0 && mkErr != EEXIST ? "cannot create " NX2_SANDBOX_ROOT "; " : "cannot enter " NX2_SANDBOX_ROOT "; ");
+		return -1;
+	}
+	strcpy(g_cwd, NX2_SANDBOX_DIR "/");
+
+	if (NX2_Apply() != 0)
+	{
+		NX2_Report("%s", "cannot replace the SD card device; ");
+		return -1;
+	}
+
+	// unmount every other file system device
+	for (int i = 0; i < STD_MAX; i++)
+	{
+		const devoptab_t *d = devoptab_list[i];
+		if (!d || !d->name || NX2_IsExpectedDevice(d->name))
+			continue;
+		char name[40];
+		snprintf(name, sizeof(name), "%.32s:", d->name);
+		NX2_Report("unmounted device %s; ", name);
+		RemoveDevice(name);
+	}
+
+	g_active = 1;
+	NX2_Report("%s", "firewall on sdmc: writes limited to " NX2_SANDBOX_ROOT);
+	return 0;
+}
+
+int NX2_FsGuardActive(void)
+{
+	if (!g_active)
+		return 0;
+	if (g_index >= 0 && devoptab_list[g_index] == &g_guarded)
+		return 1;
+	// something re-registered the SD card: put the firewall back
+	if (NX2_Apply() != 0)
+	{
+		g_active = 0;
+		return 0;
+	}
+	g_reinstalls++;
+	return 1;
+}
+
+unsigned NX2_FsGuardReinstalls(void) { return g_reinstalls; }
+const char *NX2_FsGuardInstallReport(void) { return g_report; }
+
+unsigned NX2_FsGuardDenials(void)
+{
+	return g_denials;
+}
+
+int NX2_FsGuardDenial(unsigned index, char *buf, size_t size)
+{
+	int ok = 0;
+	mutexLock(&g_denyMutex);
+	const unsigned kept = g_denials < NX2_DENIAL_KEEP ? g_denials : NX2_DENIAL_KEEP;
+	if (index < kept && size > 0)
+	{
+		const unsigned first = g_denials - kept;
+		strncpy(buf, g_denied[(first + index) % NX2_DENIAL_KEEP], size - 1);
+		buf[size - 1] = 0;
+		ok = 1;
+	}
+	mutexUnlock(&g_denyMutex);
+	return ok;
+}
+
+#endif // __SWITCH__
diff --git a/src/common/platform/posix/nx/nx2_fsguard.h b/src/common/platform/posix/nx/nx2_fsguard.h
new file mode 100644
index 0000000000..164a80a80d
--- /dev/null
+++ b/src/common/platform/posix/nx/nx2_fsguard.h
@@ -0,0 +1,38 @@
+/*
+** nx2_fsguard.h
+** UZDoom NX2: SD card write firewall (see nx2_fsguard.c).
+**
+** Copyright 2026 UZDoom NX2 contributors. GPLv3 (same as UZDoom).
+*/
+#pragma once
+
+#include <stddef.h>
+#include "nx2_pathpolicy.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Installs the firewall on the "sdmc" device, creates and enters the sandbox
+// directory and unmounts every other file system device. Called from
+// userAppInit, before any constructor runs. Returns 0, or -1 when the
+// sandbox could not be set up: the program must then not start.
+int NX2_FsGuardInstall(void);
+
+// True once NX2_FsGuardInstall succeeded and the firewall is still in place.
+// If something replaced the sdmc device in the meantime, the firewall is put
+// back (counted in NX2_FsGuardReinstalls) and the result is still true.
+int NX2_FsGuardActive(void);
+unsigned NX2_FsGuardReinstalls(void);
+
+// What happened at install time, for the log (static text).
+const char *NX2_FsGuardInstallReport(void);
+
+// Writes that were refused: their count, and the latest ones (index 0 =
+// oldest of those kept). Returns 0 when 'index' is out of range.
+unsigned NX2_FsGuardDenials(void);
+int NX2_FsGuardDenial(unsigned index, char *buf, size_t size);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/src/common/platform/posix/nx/nx2_pathpolicy.c b/src/common/platform/posix/nx/nx2_pathpolicy.c
new file mode 100644
index 0000000000..082276750d
--- /dev/null
+++ b/src/common/platform/posix/nx/nx2_pathpolicy.c
@@ -0,0 +1,189 @@
+/*
+** nx2_pathpolicy.c
+** UZDoom NX2: the write policy of the SD card sandbox. See nx2_pathpolicy.h.
+**
+** The policy is deliberately stricter than the file system: a path it is not
+** sure about is refused. A refusal only makes one write fail (the caller sees
+** EACCES); an accepted path outside the sandbox could damage the user's data.
+**
+** Copyright 2026 UZDoom NX2 contributors. GPLv3 (same as UZDoom).
+*/
+
+#include "nx2_pathpolicy.h"
+
+#include <string.h>
+
+static int NX2_IsBadChar(unsigned char c)
+{
+	if (c < 0x20 || c == 0x7f)
+		return 1;
+	switch (c)
+	{
+	case '\\': case ':': case '*': case '?': case '<': case '>': case '|': case '"':
+		return 1;
+	default:
+		return 0;
+	}
+}
+
+static char NX2_Lower(char c)
+{
+	return (c >= 'A' && c <= 'Z') ? (char)(c - 'A' + 'a') : c;
+}
+
+// Equal ignoring ASCII case (the SD card's FAT/exFAT is case-insensitive).
+static int NX2_EqualNoCase(const char *a, size_t alen, const char *b)
+{
+	size_t blen = strlen(b);
+	if (alen != blen)
+		return 0;
+	for (size_t i = 0; i < alen; i++)
+		if (NX2_Lower(a[i]) != NX2_Lower(b[i]))
+			return 0;
+	return 1;
+}
+
+// Appends the components of 'p' (no device prefix) to the canonical path in
+// 'out' (length *len, "" for the root). Handles "." and "..".
+static NX2PathVerdict NX2_AppendComponents(const char *p, char *out, size_t outSize, size_t *len)
+{
+	while (*p)
+	{
+		while (*p == '/')
+			p++;
+		if (!*p)
+			break;
+		const char *start = p;
+		while (*p && *p != '/')
+		{
+			if (NX2_IsBadChar((unsigned char)*p))
+				return NX2_PATH_BAD_CHAR;
+			p++;
+		}
+		const size_t n = (size_t)(p - start);
+
+		if (n == 1 && start[0] == '.')
+			continue;
+		if (n == 2 && start[0] == '.' && start[1] == '.')
+		{
+			if (*len == 0)
+				return NX2_PATH_ESCAPES_ROOT;
+			while (*len > 0 && out[*len - 1] != '/')
+				(*len)--;
+			// drop the separator too ("/a/b" -> "/a", "/a" -> "")
+			if (*len > 0)
+				(*len)--;
+			out[*len] = 0;
+			continue;
+		}
+
+		// "...", ". ", ".. " and names ending in '.' or ' ': file systems
+		// may trim or reinterpret them, so they are never written.
+		int onlyDots = 1;
+		for (size_t i = 0; i < n; i++)
+			if (start[i] != '.' && start[i] != ' ')
+				onlyDots = 0;
+		if (onlyDots || start[n - 1] == '.' || start[n - 1] == ' ')
+			return NX2_PATH_BAD_COMPONENT;
+
+		if (*len + 1 + n >= outSize || *len + 1 + n > NX2_PATH_MAX)
+			return NX2_PATH_TOO_LONG;
+		out[(*len)++] = '/';
+		memcpy(out + *len, start, n);
+		*len += n;
+		out[*len] = 0;
+	}
+	return NX2_PATH_OK;
+}
+
+NX2PathVerdict NX2_PathCanonical(const char *cwd, const char *path, char *out, size_t outSize)
+{
+	if (!out || outSize < 2)
+		return NX2_PATH_TOO_LONG;
+	out[0] = 0;
+	if (!path || !*path)
+		return NX2_PATH_EMPTY;
+	if (strlen(path) > NX2_PATH_MAX)
+		return NX2_PATH_TOO_LONG;
+
+	// device prefix: only "sdmc:", and only one ':' in the whole path
+	const char *colon = strchr(path, ':');
+	const char *rest = path;
+	if (colon)
+	{
+		if (strchr(colon + 1, ':'))
+			return NX2_PATH_BAD_DEVICE;
+		if ((size_t)(colon - path) != 4 || strncmp(path, "sdmc", 4) != 0)
+			return NX2_PATH_BAD_DEVICE;
+		rest = colon + 1;
+	}
+
+	size_t len = 0;
+	NX2PathVerdict v;
+	if (rest[0] != '/')
+	{
+		// relative: resolved against the working directory, as fsdev does
+		if (!cwd || cwd[0] != '/')
+			return NX2_PATH_BAD_CWD;
+		v = NX2_AppendComponents(cwd, out, outSize, &len);
+		if (v != NX2_PATH_OK)
+			return NX2_PATH_BAD_CWD;
+	}
+	v = NX2_AppendComponents(rest, out, outSize, &len);
+	if (v != NX2_PATH_OK)
+	{
+		out[0] = 0;
+		return v;
+	}
+	if (len == 0)
+	{
+		out[0] = '/';
+		out[1] = 0;
+	}
+	return NX2_PATH_OK;
+}
+
+__attribute__((noinline, used)) NX2PathVerdict NX2_PathCheck(const char *cwd, const char *path, NX2PathOp op, char *canon)
+{
+	char local[NX2_PATH_MAX + 1];
+	char *c = canon ? canon : local;
+	NX2PathVerdict v = NX2_PathCanonical(cwd, path, c, NX2_PATH_MAX + 1);
+	if (v != NX2_PATH_OK)
+		return v;
+
+	// the first two components must be "switch" and "uzdoom-nx2"
+	const char *p = c + 1;
+	const char *s1 = strchr(p, '/');
+	if (!s1 || !NX2_EqualNoCase(p, (size_t)(s1 - p), "switch"))
+		return NX2_PATH_OUTSIDE;
+	const char *p2 = s1 + 1;
+	const char *s2 = strchr(p2, '/');
+	const size_t n2 = s2 ? (size_t)(s2 - p2) : strlen(p2);
+	if (!NX2_EqualNoCase(p2, n2, "uzdoom-nx2"))
+		return NX2_PATH_OUTSIDE;
+	if (!s2)
+	{
+		// the sandbox directory itself: it may be created and entered, never
+		// written, removed or renamed
+		return (op == NX2_OP_MAKE_DIR || op == NX2_OP_CHDIR) ? NX2_PATH_OK : NX2_PATH_IS_ROOT;
+	}
+	return NX2_PATH_OK;
+}
+
+const char *NX2_PathVerdictName(NX2PathVerdict v)
+{
+	switch (v)
+	{
+	case NX2_PATH_OK: return "ok";
+	case NX2_PATH_OUTSIDE: return "outside the sandbox";
+	case NX2_PATH_IS_ROOT: return "the sandbox directory itself";
+	case NX2_PATH_BAD_DEVICE: return "device other than sdmc";
+	case NX2_PATH_BAD_CHAR: return "refused character";
+	case NX2_PATH_BAD_COMPONENT: return "refused name (dots/spaces)";
+	case NX2_PATH_ESCAPES_ROOT: return "'..' above the card root";
+	case NX2_PATH_TOO_LONG: return "path too long";
+	case NX2_PATH_EMPTY: return "empty path";
+	case NX2_PATH_BAD_CWD: return "unknown working directory";
+	}
+	return "?";
+}
diff --git a/src/common/platform/posix/nx/nx2_pathpolicy.h b/src/common/platform/posix/nx/nx2_pathpolicy.h
new file mode 100644
index 0000000000..d078ab6ef4
--- /dev/null
+++ b/src/common/platform/posix/nx/nx2_pathpolicy.h
@@ -0,0 +1,64 @@
+/*
+** nx2_pathpolicy.h
+** UZDoom NX2: the write policy of the SD card sandbox (pure C, no libnx).
+**
+** Every file system change the program makes (create, write, truncate,
+** delete, rename, mkdir, rmdir, chmod, utimes, link, symlink) must target a
+** path inside SANDBOX_ROOT on the SD card. This file decides that. It has no
+** dependency on libnx so that tests/pathpolicy_tests.c can run it on a PC.
+**
+** Copyright 2026 UZDoom NX2 contributors. GPLv3 (same as UZDoom).
+*/
+#pragma once
+
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// The only directory the program may change, as seen by the sdmc device.
+#define NX2_SANDBOX_DIR   "/switch/uzdoom-nx2"
+#define NX2_SANDBOX_ROOT  "sdmc:" NX2_SANDBOX_DIR
+
+// Longest path the policy handles (Horizon's FS_MAX_PATH is 0x301).
+#define NX2_PATH_MAX 0x300
+
+typedef enum
+{
+	NX2_PATH_OK = 0,        // inside the sandbox, operation allowed
+	NX2_PATH_OUTSIDE,       // well formed, but outside the sandbox
+	NX2_PATH_IS_ROOT,       // the sandbox directory itself (only mkdir/chdir may use it)
+	NX2_PATH_BAD_DEVICE,    // a device prefix other than "sdmc:" or several ':'
+	NX2_PATH_BAD_CHAR,      // a character the policy refuses ('\\', control, wildcards...)
+	NX2_PATH_BAD_COMPONENT, // a component made of dots/spaces, or ending in '.' or ' '
+	NX2_PATH_ESCAPES_ROOT,  // ".." above the root of the card
+	NX2_PATH_TOO_LONG,
+	NX2_PATH_EMPTY,
+	NX2_PATH_BAD_CWD,       // the working directory is unknown or not absolute
+} NX2PathVerdict;
+
+typedef enum
+{
+	NX2_OP_WRITE_FILE,  // open for writing / create / truncate, unlink, chmod, utimes, link target
+	NX2_OP_REMOVE_DIR,  // rmdir, rename of a directory
+	NX2_OP_MAKE_DIR,    // mkdir (the sandbox directory itself is allowed)
+	NX2_OP_CHDIR,       // chdir (the sandbox directory itself is allowed)
+} NX2PathOp;
+
+// Resolves 'path' as the sdmc device would (optional "sdmc:" prefix, relative
+// to 'cwd' when it does not start with '/'), normalizes "." and "..", and
+// writes the canonical absolute path ("/a/b") to 'out'. Returns NX2_PATH_OK on
+// success, or why the path is refused. Nothing is decided about the sandbox.
+NX2PathVerdict NX2_PathCanonical(const char *cwd, const char *path, char *out, size_t outSize);
+
+// Full decision for one operation: NX2_PATH_OK only when the canonical path is
+// strictly inside NX2_SANDBOX_DIR (or is that directory, for mkdir/chdir).
+// 'canon' (optional, NX2_PATH_MAX+1 bytes) receives the canonical path.
+NX2PathVerdict NX2_PathCheck(const char *cwd, const char *path, NX2PathOp op, char *canon);
+
+const char *NX2_PathVerdictName(NX2PathVerdict v);
+
+#ifdef __cplusplus
+}
+#endif
