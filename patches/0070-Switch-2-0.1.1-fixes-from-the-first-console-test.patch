--- a/src/common/platform/posix/sdl/i_system.cpp
+++ b/src/common/platform/posix/sdl/i_system.cpp
@@ -153,8 +153,22 @@ void Unix_I_FatalError(const char* errortext)
 #include "version.h"
 void I_NXShowFatalError(const char *title, const char *message);
 
+void I_ShutdownGraphics();
+
 void Switch_I_FatalError(const char* message)
 {
+	// Switch 2: one producer presents to the display layer at a time. The
+	// Vulkan swapchain (or the surface of a device that failed to start)
+	// still holds it, so the error console would stay invisible (a black or
+	// frozen screen). Release Vulkan first; a lost device can still be
+	// destroyed.
+	try
+	{
+		I_ShutdownGraphics();
+	}
+	catch (...)
+	{
+	}
 	SDL_Quit();
 	FILE *f = fopen("error.log", "w");
 	if (f)
