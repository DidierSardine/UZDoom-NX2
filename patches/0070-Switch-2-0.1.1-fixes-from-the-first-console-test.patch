diff --git a/src/common/engine/nx_perf.cpp b/src/common/engine/nx_perf.cpp
index b103c9ab34..03b7352390 100644
--- a/src/common/engine/nx_perf.cpp
+++ b/src/common/engine/nx_perf.cpp
@@ -77,9 +77,18 @@ void NXPerf_MemoryText(char *buf, size_t len)
 	u64 used = 0, total = 0;
 	svcGetInfo(&used, InfoType_UsedMemorySize, CUR_PROCESS_HANDLE, 0);
 	svcGetInfo(&total, InfoType_TotalMemorySize, CUR_PROCESS_HANDLE, 0);
+#ifdef __SWITCH2__
+	// libounce commits the whole heap to mimalloc at start-up, so the
+	// process always looks full: report the heap's own use (GPU memory of
+	// OunceVK comes from the same heap)
+	const u64 heapTotal = heapGetTotalSize(), heapFree = heapGetFreeSize();
+	snprintf(buf, len, "memory: heap in use %.0f of %.0f MB (process %.0f of %.0f MB)",
+		(heapTotal - heapFree) / 1048576.0, heapTotal / 1048576.0, used / 1048576.0, total / 1048576.0);
+#else
 	struct mallinfo mi = mallinfo();
 	snprintf(buf, len, "memory: process %.0f of %.0f MB, malloc in use %.0f MB of %.0f MB obtained",
 		used / 1048576.0, total / 1048576.0, mi.uordblks / 1048576.0, mi.arena / 1048576.0);
+#endif
 }
 #else
 void NXPerf_MemoryText(char *buf, size_t len)
