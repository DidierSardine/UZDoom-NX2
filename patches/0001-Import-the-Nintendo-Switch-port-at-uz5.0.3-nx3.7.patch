+#include <stdint.h>
+#include <stddef.h>
+
+#define BASEDIR "gzdoom"
+#define TMPDIR BASEDIR "/temp"
+
+#undef VERSION
+#define VERSION "uz5.0.3-nx3.7"
+
+enum Button
+{
+	BTN_A, BTN_B, BTN_X, BTN_Y,
+	BTN_L, BTN_R, BTN_ZL, BTN_ZR,
+	BTN_PLUS, BTN_MINUS,
+	BTN_UP, BTN_DOWN, BTN_LEFT, BTN_RIGHT,
+	BTN_LSTICK, BTN_RSTICK,
+	BTN_COUNT
+};
