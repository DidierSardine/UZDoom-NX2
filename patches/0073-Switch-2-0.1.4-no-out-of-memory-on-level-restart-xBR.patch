index 0000000000..4e7145b03e
--- /dev/null
+++ b/src/common/platform/posix/nx/nx2_parallel.cpp
@@ -0,0 +1,172 @@
+/*
+** nx2_parallel.cpp
+** UZDoom NX2: parallel_for on the Switch 2.
+**
+** UZDoom splits its xBRZ texture upscaling (gl_texture_hqresizemode 4-6)
+** into slices with parallel_for. Without OpenMP that ran on the game thread
+** alone: with xBRZ x4, restarting a level after the player's death took
+** about 6 seconds of upscaling (fourth console test, BENCH 3).
+**
+** Helper threads, one per CPU core of the process other than the game's
+** core 0, take slices; the calling thread takes slices too and then waits
+** (blocking, not spinning) for the ones already taken. A helper that cannot
+** run (a core the system does not give us) therefore never holds anything
+** up: its slices are done by the caller. Only one parallel_for runs at a
+** time; a call while one is running (from another thread or nested) runs
+** its slices on its own thread.
+**
+** Copyright 2026 UZDoom NX2 contributors. GPLv3 (same as UZDoom).
+*/
+
+#ifdef __SWITCH2__
+
+#include <switch.h>
+#include <pthread.h>
+#include <atomic>
+#include <condition_variable>
+#include <functional>
+#include <mutex>
+#include <string>
+
+#include "rdoom_nx.h"
+
+namespace
+{
+	struct Job
+	{
+		const std::function<void(int)> *fn = nullptr;
+		int count = 0;
+		std::atomic<int> next{ 0 };
+		std::atomic<int> done{ 0 };
+	};
+
+	std::mutex callMutex;		// one parallel_for at a time
+	std::mutex mutex;			// guards the fields below
+	std::condition_variable work, finished;
+	Job *current = nullptr;
+	uint64_t generation = 0;
+	int busyHelpers = 0;		// helpers that hold a pointer to current
+	int helpers = 0;
+	bool started = false;
+
+	// Runs slices of the job until none is left.
+	void RunSlices(Job &job)
+	{
+		for (;;)
+		{
+			const int i = job.next.fetch_add(1);
+			if (i >= job.count)
+				return;
+			try
+			{
+				(*job.fn)(i);
+			}
+			catch (...)
+			{
+				// one bad slice must not take the game down
+			}
+			job.done.fetch_add(1);
+		}
+	}
+
+	void *HelperMain(void *arg)
+	{
+		const int core = (int)(intptr_t)arg;
+		// the same priority as the game thread, on its own core; if the core
+		// cannot be set the thread stays where it was created and simply
+		// runs when the caller waits
+		svcSetThreadCoreMask(CUR_THREAD_HANDLE, core, 1ULL << core);
+		svcSetThreadPriority(CUR_THREAD_HANDLE, 0x2C);
+		uint64_t seen = 0;
+		for (;;)
+		{
+			Job *job;
+			{
+				std::unique_lock<std::mutex> lock(mutex);
+				work.wait(lock, [&] { return generation != seen; });
+				seen = generation;
+				job = current;
+				if (!job)
+					continue;
+				busyHelpers++;
+			}
+			RunSlices(*job);
+			{
+				std::lock_guard<std::mutex> lock(mutex);
+				busyHelpers--;
+			}
+			finished.notify_all();
+		}
+		return nullptr;
+	}
+
+	void StartHelpers()
+	{
+		started = true;
+		u64 mask = 0;
+		if (R_FAILED(svcGetInfo(&mask, InfoType_CoreMask, CUR_PROCESS_HANDLE, 0)))
+			mask = 0;
+		std::string used;
+		for (int core = 1; core < 8 && helpers < 5; core++)
+		{
+			if (!(mask & (1ULL << core)))
+				continue;
+			pthread_attr_t attr;
+			pthread_attr_init(&attr);
+			pthread_attr_setstacksize(&attr, 256 * 1024);
+			pthread_t h;
+			if (pthread_create(&h, &attr, HelperMain, (void *)(intptr_t)core) == 0)
+			{
+				helpers++;
+				used += used.empty() ? "" : ",";
+				used += std::to_string(core);
+			}
+			pthread_attr_destroy(&attr);
+		}
+		char msg[160];
+		snprintf(msg, sizeof(msg), "process core mask 0x%llx; parallel_for helpers on cores %s",
+			(unsigned long long)mask, used.empty() ? "none" : used.c_str());
+		RDoom_SessionLog("cpu", msg);
+	}
+}
+
+void NX2_ParallelFor(int count, const std::function<void(int)> &fn)
+{
+	if (count <= 0)
+		return;
+	std::unique_lock<std::mutex> call(callMutex, std::try_to_lock);
+	if (!call.owns_lock() || count == 1)
+	{
+		for (int i = 0; i < count; i++)
+			fn(i);
+		return;
+	}
+	if (!started)
+		StartHelpers();
+	if (helpers == 0)
+	{
+		for (int i = 0; i < count; i++)
+			fn(i);
+		return;
+	}
+
+	Job job;
+	job.fn = &fn;
+	job.count = count;
+	{
+		std::lock_guard<std::mutex> lock(mutex);
+		current = &job;
+		generation++;
+	}
+	work.notify_all();
+	RunSlices(job);
+	{
+		// every slice is taken: wait for the ones still running, then make
+		// sure no helper still holds the job before it goes out of scope
+		std::unique_lock<std::mutex> lock(mutex);
+		current = nullptr;
+		finished.wait(lock, [&] { return job.done.load() >= job.count && busyHelpers == 0; });
+	}
+}
+
+#endif // __SWITCH2__
