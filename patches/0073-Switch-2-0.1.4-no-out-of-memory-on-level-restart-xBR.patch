@@ -45,6 +45,21 @@ inline void parallel_for(const Index first, const Index last, const Index step,
 	});
 }
 
+#elif defined __SWITCH2__
+
+// UZDoom NX2: helper threads on the other CPU cores (nx2_parallel.cpp)
+#include <functional>
+void NX2_ParallelFor(int count, const std::function<void(int)> &fn);
+
+template <typename Index, typename Function>
+inline void parallel_for(const Index first, const Index last, const Index step, const Function& function)
+{
+	if (last <= first || step <= 0)
+		return;
+	const int count = (int)((last - first + step - 1) / step);
+	NX2_ParallelFor(count, [&](int slice) { function(first + (Index)slice * step); });
+}
+
 #else // Generic loop with optional OpenMP parallelization
 
 template <typename Index, typename Function>
